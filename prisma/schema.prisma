// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  TRANSLATOR
  ADMIN
}

enum MangaStatus {
  ONGOING
  COMPLETED
  HIATUS
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CoinTransactionType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
  BONUS
}

enum CoinTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELED
}

enum TopupOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  FAILED
}

enum TranslatorInviteStatus {
  PENDING
  ACCEPTED
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
  REVOKED
}

model User {
  id                        Int                @id @default(autoincrement())
  email                     String             @unique
  username                  String?            @unique
  name                      String?
  passwordHash              String?
  role                      UserRole           @default(USER)
  bio                       String?
  facebookUrl                String?
  tiktokUrl                  String?
  avatarUrl                 String?
  bannerUrl                 String?
  mangas                    Manga[]            @relation("UserMangas")
  bookmarks                 Bookmark[]
  readingHistory            ReadingHistory[]
  likes                     Like[]
  comments                  Comment[]
  sessions                  Session[]
  wallet                    Wallet?
  coinTransactions          CoinTransaction[]
  topupOrders               TopupOrder[]
  sentTranslatorInvites     TranslatorInvite[] @relation("TranslatorInviter")
  receivedTranslatorInvites TranslatorInvite[] @relation("TranslatorInvitee")
  reviewedTranslatorInvites TranslatorInvite[] @relation("TranslatorInviteReviewer")
  notifications             Notification[]     @relation("NotificationRecipient")
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
}

model Manga {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  title         String
  originalTitle String?
  description   String?
  coverUrl      String?
  bannerUrl     String?
  status        MangaStatus @default(ONGOING)
  visibility    Visibility  @default(PUBLIC)
  isMature      Boolean     @default(false)
  genreSlugs    Json?       @default("[]")

  // stats
  views      Int @default(0)
  likesCount Int @default(0)

  // author/uploader
  creatorId Int?
  creator   User? @relation("UserMangas", fields: [creatorId], references: [id], onDelete: SetNull)

  // relations
  chapters       Chapter[]
  tags           MangaTag[]
  bookmarks      Bookmark[]
  readingHistory ReadingHistory[]
  likes          Like[]
  comments       Comment[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([status])
  @@index([visibility])
}

model Chapter {
  id           Int     @id @default(autoincrement())
  mangaId      Int
  title        String
  number       Float // เช่น 1, 1.5, 12
  slug         String  @unique // เช่น "chapter-12" - unique globally like manga slug
  thumbnailUrl String?
  isLocked     Boolean @default(false)
  priceCoins   Int     @default(0)

  // stats
  views Int @default(0)

  manga          Manga            @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  pages          Page[]
  comments       Comment[]
  readingHistory ReadingHistory[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([mangaId, number])
  @@index([mangaId, publishedAt])
}

model Page {
  id        Int    @id @default(autoincrement())
  chapterId Int
  pageNo    Int
  imageUrl  String

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([chapterId, pageNo])
  @@index([chapterId])
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  mangas MangaTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([slug])
}

model MangaTag {
  mangaId Int
  tagId   Int

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mangaId, tagId])
  @@index([tagId])
}

model Bookmark {
  id      Int @id @default(autoincrement())
  userId  Int
  mangaId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, mangaId])
  @@index([mangaId])
}

model ReadingHistory {
  id        Int @id @default(autoincrement())
  userId    Int
  mangaId   Int
  chapterId Int
  lastPage  Int @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, mangaId])
  @@index([userId])
  @@index([mangaId])
}

model Like {
  id      Int @id @default(autoincrement())
  userId  Int
  mangaId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, mangaId])
  @@index([mangaId])
}

model Comment {
  id        Int  @id @default(autoincrement())
  userId    Int
  mangaId   Int?
  chapterId Int?

  content  String
  parentId Int?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga?   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mangaId])
  @@index([chapterId])
  @@index([parentId])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id         Int @id @default(autoincrement())
  userId     Int @unique
  balance    Int @default(0)
  totalTopup Int @default(0)
  totalSpent Int @default(0)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CoinTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoinTransaction {
  id            Int                   @id @default(autoincrement())
  walletId      Int
  userId        Int
  type          CoinTransactionType
  status        CoinTransactionStatus @default(PENDING)
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  provider      String?
  providerRef   String?
  note          String?
  metadata      Json?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([type, status])
  @@index([provider, providerRef])
}

model TopupOrder {
  id          Int              @id @default(autoincrement())
  userId      Int
  coins       Int
  amountMinor Int
  currency    String           @default("THB")
  status      TopupOrderStatus @default(PENDING)
  provider    String
  providerRef String?
  expiresAt   DateTime?
  paidAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([provider, providerRef])
}

model TranslatorInvite {
  id              Int                    @id @default(autoincrement())
  code            String                 @unique
  inviterId       Int
  inviteeEmail    String
  inviteeUserId   Int?
  status          TranslatorInviteStatus @default(PENDING)
  message         String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  adminReviewerId Int?
  adminReviewedAt DateTime?
  adminReviewNote String?
  approvedAt      DateTime?
  rejectedAt      DateTime?

  inviter       User  @relation("TranslatorInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee       User? @relation("TranslatorInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  adminReviewer User? @relation("TranslatorInviteReviewer", fields: [adminReviewerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inviterId, status])
  @@index([inviteeEmail, status])
  @@index([inviteeUserId, status])
  @@index([adminReviewerId, status])
  @@index([expiresAt])
}

enum NotificationType {
  COMMENT_ON_BOOKMARKED_MANGA
  COMMENT_ON_MY_MANGA
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  isRead    Boolean          @default(false)
  commentId Int?
  mangaId   Int?

  user    User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  manga   Manga?   @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([mangaId])
  @@index([commentId])
}
